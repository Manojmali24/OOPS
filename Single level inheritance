#include <iostream>
using namespace std;

class Human
{ 
  protected:
  string name;
};

class Student : public Human
{
  int roll_no;
  
  public:
  Student(string n, int a)
  {
    name = n;
    roll_no = a;
  }
  
  void display()
  {
    // Student obj("harsh", 2022);
    cout<<name<<" "<<roll_no;
  }
};

int main()
{
  Student obj("harsh", 2022);
  obj.display();
}
