

#include <iostream>
using namespace std;

class Human
{ 
  protected:
  string name;
};

class Person : public Human
{
  int employee_id;
  public:
  Person(string n, int id)
  {
    name = n;
    
    employee_id = id;
  }
  
  void display()
  {
    // Student obj("harsh", 2022);
    cout<<name<<" "<<employee_id<<endl;
  }
  
};

class Student : public Human
{
  int roll_no;

  
  public:
  Student(string n, int r)
  {
    name = n;
  
    roll_no = r;
  }
  
  void display()
  {
    // Student obj("harsh", 2022);
    cout<<name<<" "<<roll_no;
  }
};

int main()
{
  Person p1("harry", 2010);
  Student s1("harsh", 2022);
  p1.display();
  s1.display();
  
  
}
